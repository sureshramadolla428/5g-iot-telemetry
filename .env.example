# =============================================================================
# 5G IoT Telemetry — copy to .env and fill in. Never commit .env.
# No machine-specific IPs are hardcoded in the repo. Set them here.
# =============================================================================

COMPOSE_PROJECT_NAME=5g-iot-telemetry
DOCKER_SUBNET=172.31.240.0/24
DOCKER_GATEWAY=172.31.240.1

# Published host ports (non-standard to coexist with other labs)
MQTT_HOST_PORT=18830
GRAFANA_HOST_PORT=13000
POSTGRES_HOST_PORT=15432
CONSUMER_HEALTH_PORT=18080
KAFKA_HOST_PORT=19092
RABBITMQ_AMQP_HOST_PORT=15672
RABBITMQ_MGMT_HOST_PORT=15673

# Internal compose DNS names (do not change unless you change docker-compose.yml)
MQTT_INTERNAL_HOST=mosquitto
MQTT_INTERNAL_PORT=1883
POSTGRES_INTERNAL_HOST=timescaledb
POSTGRES_INTERNAL_PORT=5432
GRAFANA_INTERNAL_PORT=3000
CONSUMER_INTERNAL_PORT=8080

# MQTT (anonymous disabled). Change these before any non-lab use.
MQTT_USERNAME=iotuser
MQTT_PASSWORD=change-me-mqtt
MQTT_KEEPALIVE=120
MQTT_CONNECT_TIMEOUT=30
MQTT_QOS=1

# Broker address seen by the *host* UE simulator.
# Direct mode: typically 127.0.0.1
# 5G mode: the IPv4 the UE user-plane can reach (often the host DN / N6 address).
# Leave as 127.0.0.1 for BIND_MODE=direct. See docs/5g-integration.md.
MQTT_HOST=127.0.0.1
MQTT_PORT=18830

# TimescaleDB
POSTGRES_USER=iot
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=iot

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana
GF_USERS_ALLOW_SIGN_UP=false

# UE simulator
BIND_MODE=5g
# Direct-mode fleet size (1–100). Use with BIND_MODE=direct.
# BIND_MODE=5g cannot invent tunnels; leave unset or match devices.yaml length.
# DEVICE_COUNT=50
DEVICE_MAP_PATH=config/devices.yaml
PUBLISH_INTERVAL_SECONDS=2.0
TELEMETRY_LOG_LEVEL=INFO
RADIO_MODEL_PATH=config/radio_model.yaml
ENABLE_NTN_MODEL=false
ENABLE_A2G_MODEL=false

# Backend consumer
CONSUMER_CLIENT_ID=iot-backend-consumer
BATCH_SIZE=50
BATCH_FLUSH_SECONDS=2.0
DEAD_LETTER_MAX_PAYLOAD_BYTES=8192

# Optional bridges (off by default). Enable only with compose profile "extras".
ENABLE_KAFKA_BRIDGE=false
ENABLE_AMQP_BRIDGE=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=iot.telemetry
AMQP_URL=amqp://iotuser:change-me-amqp@rabbitmq:5672/%2F
AMQP_EXCHANGE=iot
AMQP_ROUTING_KEY=telemetry

# RabbitMQ (extras profile)
RABBITMQ_DEFAULT_USER=iotuser
RABBITMQ_DEFAULT_PASS=change-me-amqp
